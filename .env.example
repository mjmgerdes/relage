# Copy to .env to enable real SMS through Twilio.
# Without these, messages appear only in the in-app phone simulator.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+15551234567
# Optional override; otherwise texts go to the caregiver phone in the profile
# (must be E.164, e.g. +15559876543)
# CAREGIVER_PHONE=+15559876543
