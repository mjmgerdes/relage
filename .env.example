# Copy to .env for real telephony. Without any of this, the in-app phone
# simulator carries the whole demo flow — no external dependencies.

# --- Twilio (voice channel: real call to the caregiver's phone) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+15551234567          # a Twilio number you own
CAREGIVER_PHONE=+15559876543      # real phone that rings during the demo (E.164)

# Public URL for Twilio's speech-gather + call-status webhooks:
#   ngrok http 8787   ->  paste the https URL here
BASE_URL=https://your-tunnel.ngrok-free.dev

# SMS from unregistered US local numbers is carrier-blocked (A2P 10DLC).
# Leave this set unless your number has an approved A2P campaign.
TWILIO_SMS_DISABLED=1

# --- ElevenLabs (natural voice on calls; falls back to Polly Neural) ---
ELEVENLABS_API_KEY=sk_xxx
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # optional, defaults to Rachel

# --- Gemma routing (optional overrides) ---
# GEMMA_FAST=gemma3:4b
# GEMMA_DEEP=gemma4:latest
